# Copy to .env (gitignored) and fill in. Never commit .env.
# Variables set in the shell override this file, e.g.  DRY_RUN=false npm run review

# --- Your Instagram account ---
IG_USERNAME=
# Optional. Leave empty to log in by hand in the browser window that `npm run login` opens.
IG_PASSWORD=

# --- Comment drafting (Google Gemini) ---
# Optional. Without it you write each comment yourself during review.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-lite-latest
# AI_PROMPT_HINT=Keep it upbeat; I mostly comment on cooking reels.

# --- Safety and pacing ---
# Dry run stays ON unless this is exactly "false".
DRY_RUN=true
# Reels opened per calendar day (review and auto), so also the most comments a day.
DAILY_LIMIT=20
# Minimum seconds between Instagram page loads.
ACTION_DELAY_SECONDS=30
# false = show the browser while reviewing (also lets you clear security checks inline).
HEADLESS=true

# --- Automatic liking and commenting (npm run auto) ---
# Your group chats, comma-separated: add and auto read the reels shared in them today.
GROUP_CHATS=
# Minimum seconds between two posted comments, also across runs. 60 is the least I would go.
COMMENT_GAP_SECONDS=90
# Most comments a day on posts by the same account; the rest of their reels wait for another day.
AUTHOR_DAILY_LIMIT=2

# --- DM export import ---
# Conversations you authorise, comma-separated: export folder names (alice_1234567890) or chat titles.
AUTHORIZED_THREADS=
